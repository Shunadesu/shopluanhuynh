PORT=9003
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/shopluanhuynh
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# EmailJS Configuration (Optional - for OTP)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# Encryption for account credentials
ENCRYPTION_KEY=12345678901234567890123456789012

# Client URLs
CLIENT_URL=http://localhost:9004
ADMIN_URL=http://localhost:9002

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
